{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": ["vitre.d.ts", "src/**/*.ts", "src/**/*.tsx", "site/**/*.ts", "site/**/*.tsx"],
  "exclude": ["site/vite.config.ts"]
}
