{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "reintent-core",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "reintent-core": ["./src/core/index.ts"],
      "reintent-core/jsx-runtime": ["./src/core/jsx-runtime.ts"],
      "reintent-core/jsx-dev-runtime": ["./src/core/jsx-dev-runtime.ts"],
      "reintent-core/lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.tsx", "../../experiences/reintent/intents/**/*.ts", "../../experiences/reintent/program/**/*.tsx"]
}
