{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "reintent-core": ["./src/index.ts"],
      "reintent-core/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
}
